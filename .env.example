# Hosted API (Render). Never set hosted mode without an exact public HTTPS origin.
WEBSCOPE_DEPLOYMENT=hosted
WEBSCOPE_PUBLIC_ORIGIN=https://your-webscope-frontend.vercel.app
WEBSCOPE_ALLOWED_HOSTS=your-webscope-api.onrender.com
WEBSCOPE_DATA_DIR=/tmp/webscope

# Vercel project, Root Directory: frontend.
# Used during npm run build:vercel to emit same-origin API routes; not a browser secret.
WEBSCOPE_API_ORIGIN=https://your-webscope-api.onrender.com
